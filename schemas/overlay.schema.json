{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/petrovicistefan/world-map-open-source/schemas/overlay.schema.json",
  "title": "World Map Open Source Overlay",
  "description": "GeoJSON FeatureCollection for curated map overlays",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "FeatureCollection" },
    "name": { "type": "string" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["Point", "LineString", "Polygon", "MultiPoint", "MultiLineString", "MultiPolygon"]
            },
            "coordinates": true
          }
        },
        "properties": {
          "type": "object",
          "required": ["id", "name", "category", "kind", "source", "license"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[/_-][a-z0-9]+)*$",
              "minLength": 3
            },
            "name": { "type": "string", "minLength": 1 },
            "category": {
              "type": "string",
              "enum": ["places", "nature", "transport", "culture", "community", "events", "hazards", "accessibility", "food_rescue"]
            },
            "kind": { "type": "string", "minLength": 1 },
            "source": {
              "type": "string",
              "enum": ["survey", "osm-gap", "agent", "import"]
            },
            "license": { "type": "string", "minLength": 1 },
            "verified_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "website": { "type": "string" },
            "opening_hours": { "type": "string" },
            "extra": { "type": "object" }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
