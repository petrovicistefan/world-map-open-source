{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/petrovicistefan/world-map-open-source/schemas/taxonomy.json",
  "title": "World Map Open Source Overlay Taxonomy",
  "description": "Curated overlays: services useful to women + spaces for children. Not charity banks; not a full OSM mirror.",
  "version": "0.3.1",
  "default_license": "ODbL-1.0",
  "id_convention": "{category}/{city}-{slug}",
  "product_focus": [
    "women",
    "children"
  ],
  "sources": [
    {
      "id": "survey",
      "description": "On-site or trusted human verification"
    },
    {
      "id": "osm-gap",
      "description": "Useful detail missing or weak in OSM / basemap"
    },
    {
      "id": "agent",
      "description": "Drafted by an AI agent; validate before PR"
    },
    {
      "id": "import",
      "description": "Bulk or curated import with documented provenance"
    }
  ],
  "categories": [
    {
      "id": "services",
      "status": "mvp",
      "review_policy": "open",
      "priority": 1,
      "description": "Everyday local services especially useful to women \u2014 salon, tailor, laundry, midwife, physio \u2014 curated pins, not every shop",
      "kinds": [
        "hairdresser",
        "beauty_salon",
        "nail_salon",
        "tailor",
        "laundry",
        "dry_clean",
        "shoe_repair",
        "jewelry_repair",
        "physiotherapy",
        "yoga_studio",
        "midwife",
        "gyn_clinic",
        "cosmetics_shop"
      ],
      "icon": "assets/icons/services.svg",
      "color": "#7b1fa2"
    },
    {
      "id": "family",
      "status": "mvp",
      "review_policy": "open",
      "priority": 1,
      "description": "Spaces for children: playgrounds, indoor play, creche / Kita / after-school \u2014 plus practical facilities when out with kids",
      "kinds": [
        "playground",
        "indoor_play",
        "creche",
        "kita",
        "after_school",
        "changing_table",
        "nursing_room",
        "family_restroom",
        "stroller_friendly",
        "pediatric_clinic"
      ],
      "icon": "assets/icons/family.svg",
      "color": "#e91e63"
    },
    {
      "id": "places",
      "status": "mvp",
      "review_policy": "open",
      "description": "Everyday amenities (pharmacy, caf\u00e9s, toilets, libraries)",
      "kinds": [
        "cafe",
        "coworking",
        "library",
        "toilet",
        "drinking_water",
        "atm",
        "wifi",
        "pharmacy"
      ],
      "icon": "assets/icons/places.svg",
      "color": "#0d6e6e"
    },
    {
      "id": "nature",
      "status": "mvp",
      "review_policy": "open",
      "description": "Outdoors and landscape-oriented features",
      "kinds": [
        "viewpoint",
        "trailhead",
        "swim",
        "picnic",
        "dark_sky",
        "park_gate"
      ],
      "icon": "assets/icons/nature.svg",
      "color": "#2f7d32"
    },
    {
      "id": "transport",
      "status": "mvp",
      "review_policy": "open",
      "description": "Micromobility and last-mile infrastructure often incomplete on basemaps",
      "kinds": [
        "bike_parking",
        "ev_charger",
        "carshare",
        "micromobility"
      ],
      "icon": "assets/icons/transport.svg",
      "color": "#1565c0"
    },
    {
      "id": "culture",
      "status": "mvp",
      "review_policy": "open",
      "description": "Art, venues, and cultural landmarks curated by contributors",
      "kinds": [
        "mural",
        "venue",
        "memorial",
        "exhibition"
      ],
      "icon": "assets/icons/culture.svg",
      "color": "#6a1b9a"
    },
    {
      "id": "community",
      "status": "mvp",
      "review_policy": "human_required",
      "description": "Mutual aid and civic services. Agents draft only. Never publish secret refuge coordinates.",
      "kinds": [
        "mutual_aid",
        "tool_library",
        "repair_cafe",
        "cooling_center",
        "free_wifi",
        "women_support"
      ],
      "icon": "assets/icons/community.svg",
      "color": "#c62828"
    }
  ],
  "later_categories": [
    {
      "id": "food",
      "note": "bakery, market, street_food"
    },
    {
      "id": "sport",
      "note": "outdoor_gym, skatepark"
    },
    {
      "id": "accessibility",
      "kinds_ideas": [
        "step_free",
        "accessible_toilet",
        "stroller_route"
      ]
    },
    {
      "id": "events",
      "note": "Time-bound pins need start/end"
    },
    {
      "id": "hazards",
      "note": "Strict human-only"
    },
    {
      "id": "food_rescue",
      "kinds_ideas": [
        "community_fridge"
      ]
    }
  ],
  "safety_rules": [
    "Do not map confidential domestic-violence shelters or safe houses",
    "No PII of minors or private home addresses",
    "women_support only for publicly listed organizations",
    "creche/kita: public listings only \u2014 no private home daycare addresses"
  ],
  "namespaces": [
    {
      "id": "gta6",
      "path": "overlays/_ns/gta6/",
      "status": "active",
      "review_policy": "open",
      "description": "Unofficial fan map of Leonida-inspired points on real South Florida geography. Not affiliated with Rockstar Games.",
      "kinds": [
        "landmark",
        "district",
        "safehouse",
        "clothing",
        "gun_shop",
        "barber",
        "tattoo",
        "convenience",
        "gas_station",
        "garage",
        "hospital",
        "police",
        "club",
        "bar",
        "airport",
        "marina",
        "port",
        "beach",
        "park",
        "collectible"
      ]
    }
  ],
  "layer_contract": {
    "description": "When creating a new overlay category/layer, set id, kinds, review_policy, icon (SVG under assets/icons/), and color. The demo loads icon onto the map as a MapLibre symbol.",
    "required_fields": [
      "id",
      "kinds",
      "review_policy",
      "icon",
      "color",
      "description",
      "status"
    ]
  }
}
