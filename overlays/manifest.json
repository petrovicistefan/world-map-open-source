{
  "version": "0.3.2",
  "name": "world-map-open-source-overlays",
  "description": "Stable index of curated GeoJSON overlays. Resolve each url/icon/taxonomy against a base (repo root locally, or GitHub Pages).",
  "default_license": "ODbL-1.0",
  "city": "berlin",
  "center": [13.405, 52.52],
  "zoom": 12,
  "style_url": "https://tiles.openfreemap.org/styles/liberty",
  "taxonomy": "schemas/taxonomy.json",
  "bases": {
    "pages": "https://petrovicistefan.github.io/world-map-open-source",
    "local_note": "Serve the repo root (e.g. python3 -m http.server 5173) and use base http://localhost:5173"
  },
  "cache": {
    "note": "Pin consumers should re-fetch manifest + GeoJSON on each load (or short TTL). Do not vendor-copy overlays into your app if you want upstream updates.",
    "expected_publish_after_merge_minutes": "1-3"
  },
  "overlays": [
    {
      "id": "services",
      "category": "services",
      "url": "overlays/services/berlin.geojson",
      "color": "#7b1fa2",
      "icon": "assets/icons/services.svg"
    },
    {
      "id": "family",
      "category": "family",
      "url": "overlays/family/berlin.geojson",
      "color": "#e91e63",
      "icon": "assets/icons/family.svg"
    },
    {
      "id": "places",
      "category": "places",
      "url": "overlays/places/berlin.geojson",
      "color": "#0d6e6e",
      "icon": "assets/icons/places.svg"
    },
    {
      "id": "nature",
      "category": "nature",
      "url": "overlays/nature/berlin.geojson",
      "color": "#2f7d32",
      "icon": "assets/icons/nature.svg"
    },
    {
      "id": "transport",
      "category": "transport",
      "url": "overlays/transport/berlin.geojson",
      "color": "#1565c0",
      "icon": "assets/icons/transport.svg"
    },
    {
      "id": "culture",
      "category": "culture",
      "url": "overlays/culture/berlin.geojson",
      "color": "#6a1b9a",
      "icon": "assets/icons/culture.svg"
    },
    {
      "id": "community",
      "category": "community",
      "url": "overlays/community/berlin.geojson",
      "color": "#c62828",
      "icon": "assets/icons/community.svg"
    }
  ]
}
